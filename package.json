{
  "name": "zotero-flexannotate",
  "type": "module",
  "version": "3.0.0",
  "description": "FlexAnnotate: an annotation overhaul for Zotero. Edit locators and comments, organize annotations in an outline, cite with document tracking and direct jump, annotate printed books, import Citavi quotes.",
  "config": {
    "addonName": "FlexAnnotate",
    "addonID": "flexannotate@justanotherjurastudent.github.io",
    "addonRef": "flexannotate",
    "addonInstance": "FlexAnnotate",
    "prefsPrefix": "extensions.flexannotate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justanotherjurastudent/zotero_FlexAnnotate.git"
  },
  "author": "justanotherjurastudent",
  "bugs": {
    "url": "https://github.com/justanotherjurastudent/zotero_FlexAnnotate/issues"
  },
  "homepage": "https://github.com/justanotherjurastudent/zotero_FlexAnnotate#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "build": "zotero-plugin build && npm run typecheck",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:zotero": "node scripts/run-zotero-tests.mjs",
    "test:versions": "node scripts/run-versions.mjs",
    "screenshots": "node scripts/run-zotero-tests.mjs --screenshots",
    "screenshots:docs": "node scripts/docs-screenshots.mjs",
    "verify": "npm run lint:check && npm run build && npm run test:unit && npm run test:zotero",
    "test:unit": "node --test \"test-unit/*.test.ts\"",
    "test:unit:coverage": "node --test --experimental-test-coverage \"test-unit/*.test.ts\"",
    "test:unit:repeat": "node scripts/repeat-unit-tests.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "zotero-plugin-scaffold": "^0.9.3",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
