{
  "name": "zotero-annotree",
  "type": "module",
  "version": "0.2.2",
  "description": "Annotree: sort Zotero annotations and works into an outline (Citavi-style knowledge organizer), usable from the Word citation dialog.",
  "config": {
    "addonName": "Annotree",
    "addonID": "annotree@justanotherjurastudent.github.io",
    "addonRef": "annotree",
    "addonInstance": "Annotree",
    "prefsPrefix": "extensions.zotero.annotree"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justanotherjurastudent/zotero_Annotree.git"
  },
  "author": "justanotherjurastudent (based on Lattice by birugit)",
  "bugs": {
    "url": "https://github.com/justanotherjurastudent/zotero_Annotree/issues"
  },
  "homepage": "https://github.com/justanotherjurastudent/zotero_Annotree#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:zotero": "node scripts/run-zotero-tests.mjs",
    "verify": "npm run lint:check && npm run build && npm run test:unit && npm run test:zotero",
    "test:unit": "node --test \"test-unit/*.test.ts\"",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
