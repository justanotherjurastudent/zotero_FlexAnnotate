    {
      "id": "claim_88aa13780f7d44418504a67ad3090f81",
      "statement": "The citeOnlyPatch feature installs the _insertCitingResult wrapper through assignChecked with feature detection of both _insertCitingResult and _insertItemsIntoDocument (a missing target logs \"cite-only stays disabled\" and returns false), guards against double installation via the module-level installed record, restores the original in unpatch() (nulling installed before restoring), re-reads the citationOnly pref on every call, captures the native function in the wrapper closure, and logs any wrapper error via Zotero.logError before falling through natively; a failed start() throws so the registry logs the failure.",
      "evidence": [
        {
          "resource": "repo://src/features/citeOnly/integrationPatch.ts#L122-L209",
          "version": "repo-lines-v1:sha256:363c2261503e193dc9b315c3272fd6ddc83594a9281882d6d6f09c0ba2ebf7bc:"
