          "version": "repo-lines-v1:sha256:b5a624089ce262916e423c21177c919ddb4a5f27da756208085f014103462a02:"
        }
      ]
    },
    {
      "id": "claim_3ef4df1fb4a54ae98605d4125059cef8",
      "statement": "For every accepted entry citationOnlyItems returns a new list without mutating its input: each entry spreads the original citation item, overrides id with the parent item id, clears uris and itemData, and — only when the annotation's page label is non-empty — sets locator to the page label and label to the resolved locator type; an annotation without a page label keeps the original locator/label fields. Order and per-item parents are preserved, and every behavior is pinned by test-unit/citeOnly.test.ts.",
      "evidence": [
        {
          "resource": "repo://src/features/citeOnly/logic/citeOnly.ts#L43-L63",
          "version": "repo-lines-v1:sha256:3eb499f1e679fdf8da032dc1289d5428434ea105d33bafa11ae8b2c0ece7749a:"
