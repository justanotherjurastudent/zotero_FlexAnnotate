    {
      "id": "claim_0b9121b71c234c61b66fea81f4326853",
      "statement": "The pure decision function citationOnlyItems(items, refs) in src/features/citeOnly/logic/citeOnly.ts builds the new citation item list or returns null, and null means native fallthrough; it takes no Zotero imports (the caller resolves items via Zotero.Cite.getItem and locator types via tags) so it runs under the Node test runner. It returns null when the item list is empty, when refs and items differ in length, when a ref is missing (mixed selection), or when an annotation has no citable top-level item (topLevelId null).",
      "evidence": [
        {
          "resource": "repo://src/features/citeOnly/logic/citeOnly.ts#L28-L63",
          "version": "repo-lines-v1:sha256:d2042a33ca850a585eddf5f9a45a76476f6f703ba5f60b494a27460f982f800c:"
