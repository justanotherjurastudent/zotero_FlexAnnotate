    {
      "id": "claim_ebebad06f41b4961a57aac4c762e7837",
      "statement": "rewriteToCitationOnly mutates the citation object in place (assigning citation.citationItems) and returns the same object instead of a clone, because a clone would lose the prototype of Zotero.Integration.Citation that the session later needs for .serialize(); the mutation happens only after full validation (items present, every item an annotation, citationOnlyItems returned a list), after which citation.loadItemData() is awaited when present.",
      "evidence": [
        {
          "resource": "repo://src/features/citeOnly/integrationPatch.ts#L79-L116",
          "version": "repo-lines-v1:sha256:91b5ac1b4702386daee77b79e7e68540cdcec9bd1d404e30723f10249a3b4c81:"
        }
