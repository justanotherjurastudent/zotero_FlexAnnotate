    {
      "id": "claim_0c93274cc8fe4d688db19126064c4f0c",
      "statement": "QUOTATION_TYPES maps the Citavi QuotationType to annotation color and field distribution — type 2 (indirect quote) swaps the fields so the core statement becomes the text and the original quote the comment, types 5 and 6 drop the comment, unknown/missing types fall back to type 1 (#2ea8e5) — and an empty quote falls back to the core statement as text, a deliberate deviation from Zotero's translator that would otherwise lose the quote.",
      "evidence": [
        {
          "resource": "repo://src/features/citavi/logic/citavi.ts#L251-L291",
          "version": "repo-lines-v1:sha256:5fe541c488769429e6a60489f9fd5b7278db44bc946c781c6f3859437171baab:"
        },
        {
