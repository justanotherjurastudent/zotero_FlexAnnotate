    },
    {
      "id": "claim_dfc64da9052842999a47b51d7953e242",
      "statement": "importPrintQuotes re-initializes the consumed XML stream via translation._io.init(\"xml/dom\"), collects anchored KnowledgeItem ids from //EntityLinks/EntityLink/SourceID, and skips anchored quotes only when their source has an annotatable attachment (attachmentReaderType set and not the plugin's placeholder); every other KnowledgeItem is converted to a print annotation created under the work's placeholder attachment.",
      "evidence": [
        {
          "resource": "repo://src/features/citavi/citaviPrintQuotes.ts#L113-L218",
          "version": "repo-lines-v1:sha256:d4e09e01c94822d1ee76868c83ce9a973dca8dd8e71499319410ab16c37c3cdd:"
        }
      ]
    },
    {
      "id": "claim_395d7ab8d69b499eb14e69202ffd2c19",
      "statement": "importPrintQuotes counts a skip reason per category (noReference, noItem, notRegular, handledByZotero, empty, duplicates) so the summary log line makes a `created 0` result interpretable.",
      "evidence": [
        {
          "resource": "repo://src/features/citavi/citaviPrintQuotes.ts#L138-L146",
          "version": "repo-lines-v1:sha256:91e9e1e7221d83a069130f60052107013ca605a9b9ba1c7c4c2a38a0f953c9a1:"
