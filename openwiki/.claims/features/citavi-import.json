        }
      ]
    },
    {
      "id": "claim_dc19aaf3ec8a43dfb5755b032e7a15a4",
      "statement": "createLocatorResolver reads its preference on every call (so a changed setting takes effect without restart), falls back to \"page\" for an empty preference value, and maps unknown <nt> types to citaviLocatorOther while reporting each unknown type exactly once per resolver via an injected callback so a mis-guessed locator name cannot stay invisible.",
      "evidence": [
