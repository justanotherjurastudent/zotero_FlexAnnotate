    {
      "id": "claim_4c7bd437671f4e53ac1d279264dc23dd",
      "statement": "Before saving, a candidate quote is compared against the existing annotations of the same work's placeholder via isDuplicateAnnotation: a duplicate has the same page label and the same normalized quote text (whitespace collapsed, markup and entities stripped), an empty text compares the comment instead, and with text present the comment is ignored because users may edit it after import — so a second import of the same export creates nothing (asserted as created: 0, duplicates: 2 in the integration test).",
      "evidence": [
        {
          "resource": "repo://src/features/citavi/citaviPrintQuotes.ts#L191-L209",
          "version": "repo-lines-v1:sha256:13f7de695fe60e64fb888033747583bf0f3753a6b8a06526faa77917e427ef06:"
