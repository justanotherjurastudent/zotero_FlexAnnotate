    {
      "id": "claim_d6cbf4b23a924beebe7439006c930d2b",
      "statement": "linkContributions reads //ReferenceReferences/OnetoN texts in the format ParentID;ChildID1;ChildID2;… — which Zotero's translator ignores because the seeAlso code in translate_item.js is commented out — and adds bidirectional related-item links between the host work and each contribution and among sibling contributions of the same group, collecting all pairs first and saving changed items in a single Zotero.DB.executeTransaction with skipDateModifiedUpdate: true.",
