        }
      ]
    },
    {
      "id": "claim_a367809c8f604a5d99b04a3ca8cfeede",
      "statement": "parsePageRange reads the raw <PageRange> text with escaped markup intact: the page label is the <os> display form, falling back to PageRangeNumber unless it is \"-1\" (Citavi's no-page marker) in which case the label stays empty, and the CSL locator is resolved from the <nt> numbering type through LOCATOR_PREF_BY_NUMBER_TYPE (missing <nt> means a page and maps to citaviLocatorPage).",
      "evidence": [
        {
          "resource": "repo://src/features/citavi/logic/citavi.ts#L148-L171",
          "version": "repo-lines-v1:sha256:ce3a9e27deb11f4274b6095a4fed58806da10bae9854ac7cd34639e514ecd7d7:"
