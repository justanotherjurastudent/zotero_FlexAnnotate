        }
      ]
    },
    {
      "id": "claim_b04978a8c4914ff38256dcb4835222aa",
      "statement": "When citaviKeepNotes is off, the pass erases the translator's note for each created annotation, but only if the note genuinely belongs to the quote: isQuoteNote requires the normalized note text to start with CoreStatement + Text and the remainder to pass isPageTail (at most MAX_NOTE_TAIL = 60 characters of digits, whitespace and dashes), so a longer tail with letters — the user's own annotation — is never deleted; removal runs only for annotations actually created, not for duplicates.",
      "evidence": [
