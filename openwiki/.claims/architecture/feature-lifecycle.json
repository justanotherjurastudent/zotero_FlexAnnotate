    {
      "id": "claim_f29845e33fe64d03948f5a0ddcf46570",
      "statement": "Work is split strictly by scope: start/stop own once-per-session global state (prototype patches, Zotero.Notifier observers, Zotero.MenuManager menus, installs on the shared Zotero object) while addToWindow/removeFromWindow own per-window DOM. Both halves must be idempotent: window hooks check for their own element IDs before inserting, keep per-window listeners in WeakMaps keyed by window (never module-level state), and removeFromWindow removes exactly what addToWindow added — asserted by the Zotero toolbar-button test (second addToWindow does not duplicate, removeFromWindow removes button and listener).",
      "evidence": [
        {
          "resource": "repo://src/features/organizer/toolbarButton.ts#L17-L63",
          "version": "repo-lines-v1:sha256:65e2a0b1b9a3596786b9d29746548b73da95f9af3eb99257d890f88ca0ea7b70:"
