    {
      "id": "claim_714150070c04472c96ef1c68d029785f",
      "statement": "onShutdown runs ztoolkit.unregisterAll(), then stopAll(features) in reverse order (patches restored, citation-dialog injectors detached including in still-open dialogs, MenuManager menus unregistered by key, annotation-index observer unregistered, external API removed, organizer window closed), then sets addon.data.alive = false and deletes Zotero[config.addonInstance]; bootstrap calls hooks.onShutdown() only for non-APP_SHUTDOWN reasons and destructs the chrome handle afterwards.",
