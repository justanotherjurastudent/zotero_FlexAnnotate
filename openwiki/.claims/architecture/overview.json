    {
      "id": "claim_6ee6347c7f2c4eea98df1da1dc9dbac2",
      "statement": "addon/bootstrap.js is a thin loader: its startup registers the chrome mapping for content/, creates the plugin sandbox ctx whose _globalThis is itself, loads content/scripts/__addonRef__.js (the bundled src/index.ts) with ignoreCache: true so a stale startup-cache copy cannot be served, then awaits Zotero.FlexAnnotate.hooks.onStartup(); onMainWindowLoad, onMainWindowUnload and shutdown forward to the same hooks object.",
      "evidence": [
        {
          "resource": "repo://addon/bootstrap.js#L12-L57",
          "version": "repo-lines-v1:sha256:be19c787c3944df7dc2537a62000d6de84dfc82d458321174803c478124631cf:"
        }
