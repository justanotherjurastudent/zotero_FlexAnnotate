    },
    {
      "id": "claim_bc12f422eecd473db8d5594d3442d5e2",
      "statement": "onStartup awaits Zotero's initializationPromise, unlockPromise and uiReadyPromise, then calls initLocale(), builds addon.api (the surface the Zotero tests use), registers the preference pane via Zotero.PreferencePanes.register, awaits startAll(features), runs onMainWindowLoad for every open main window and only then sets addon.data.initialized = true; onMainWindowLoad recreates the ztoolkit, inserts the two FTL files and runs addToWindow; onMainWindowUnload runs removeFromWindow plus ztoolkit.unregisterAll(); onShutdown unregisters toolkit UI, runs stopAll in reverse, closes the plugin dialog and deletes Zotero[config.addonInstance].",
      "evidence": [
        {
          "resource": "repo://src/hooks.ts#L131-L237",
