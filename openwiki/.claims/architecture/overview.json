    {
      "id": "claim_f58df403b5cf403695e59555b8f73807",
      "statement": "src/shared/feature.ts defines the Feature contract (start, stop, addToWindow, removeFromWindow) and invokes hooks so that a failing feature neither blocks the others nor throws: startAll runs in array order awaiting async hooks, stopAll and removeFromWindow run in reverse, failures are logged via a defaultLogger that reads the ztoolkit global lazily inside try/catch so the registry itself stays importable under Node.",
      "evidence": [
        {
          "resource": "repo://src/shared/feature.ts#L21-L105",
          "version": "repo-lines-v1:sha256:176701b9912f6f44c35f4566d7b462bb4e425cd13c33ef793682426a5555bc90:"
        },
        {
