pref-section = Organizer
pref-show-works =
    .label = Werke hinter den Annotationen mitanzeigen
pref-show-works-hint = An: Die Annotationsansicht zeigt Werke samt Annotationen (Zotero-Standard). Aus: Es werden nur die der Kategorie zugewiesenen Annotationen angezeigt (wie im Wissen-Tab von Citavi).

prefs-citing-heading = Zitieren in Word und LibreOffice
prefs-citation-only =
    .label = Standardmäßig nur den Nachweis einfügen
prefs-citation-only-description =
    Beim Einfügen von Annotationen wird nur die Zitation mit Seitenangabe gesetzt — ohne
    Zitattext und Kommentar.

prefs-print-heading = Print-Annotationen
prefs-keep-placeholders =
    .label = Leere Platzhalter-Anhänge behalten
prefs-keep-placeholders-description =
    Print-Annotationen brauchen einen Datei-Anhang als technischen Träger. Ist die Option aus,
    entfernt FlexAnnotate den Platzhalter, sobald die letzte Annotation darunter gelöscht wurde.

prefs-citavi-heading = Citavi-Import
prefs-citavi-import =
    .label = Zitate ohne Dateianhang als Print-Annotationen übernehmen
prefs-citavi-import-description =
    Zoteros Citavi-Import übernimmt nur Zitate, die an einer PDF-Stelle hängen. Ist die
    Option an, legt FlexAnnotate für die übrigen Zitate Print-Annotationen an.

prefs-citavi-keep-notes =
    .label = Notiz zum Zitat behalten
prefs-citavi-keep-notes-description =
    Zotero legt zu jedem Citavi-Zitat zusätzlich eine Notiz an. Ist die Option aus,
    entfernt FlexAnnotate die Notiz zu genau den Zitaten, die es selbst als
    Print-Annotation übernommen hat — Notizen zu PDF-Zitaten bleiben unberührt.

prefs-citavi-link-contributions =
    .label = Beiträge mit ihrem Hauptwerk verknüpfen
prefs-citavi-link-contributions-description =
    Citavi weiß, welche Beiträge zu einem Sammelwerk, Gesetzeskommentar oder Tagungsband
    gehören. Ist die Option an, legt FlexAnnotate nach dem Import „Verwandte"-Verknüpfungen
    zwischen dem Beitrag und seinem Hauptwerk an — und zwischen Geschwisterbeiträgen untereinander.

prefs-citavi-locator-heading = Fundstellen zitieren als
prefs-citavi-locator-page =
    .value = Seite
prefs-citavi-locator-column =
    .value = Spalte
prefs-citavi-locator-paragraph =
    .value = Paragraph
prefs-citavi-locator-margin =
    .value = Randnummer
prefs-citavi-locator-other =
    .value = Andere
prefs-citavi-locator-description =
    Links Citavis Seitentyp, rechts der Locator der Zitation. Für Randnummern kennt CSL
    keine Entsprechung — je nach Zitierstil passt „Absatz", „Opus" oder „Spalte".
